+++ b/lib/scrawly_web/demo_board.ex
@@ -0,0 +1,173 @@
+defmodule ScrawlyWeb.DemoBoard do
+  @moduledoc """
+  The home page's demo-board commands over Hologram Realtime. Server-only.
+
+  The board is open to visitors without an account, so every command is
+  validated and rate-limited per `ScrawlyWeb.Auth.actor_key/1`
+  (`ScrawlyWeb.RateLimiter`, limits in `limits/0`): the per-socket limits
+  `ScrawlyWeb.DemoBoardChannel` applies, plus the live chunk stream's.
+
+    * `load/2`: the stored strokes (`:demo_board_loaded %{strokes}`), loaded
+      by a command after mount rather than in init state (up to 500 strokes
+      of up to 8,000 chars).
+    * `chunk/2`: one live chunk of the stroke being drawn
+      (`Scrawly.Games.StrokeRules.chunk/1`). Valid -> relayed to the other
+      tabs as `:demo_chunk_in` with `put_broadcast_except` (never back to the
+      sender); always answered `:demo_chunk_acked %{ok}`. The client sends
+      the next chunk only after the ack, so one chunk command per drawer is in
+      flight and a drawer's chunks reach the board in order.
+    * `complete_stroke/2`: a finished stroke. Valid -> stored by
+      `Scrawly.Games.DemoBoardServer`, which pushes `:demo_stroke_added` to
+      every tab (the sender confirms its pending stroke by id). Invalid ->
+      peers get `:demo_stroke_abandon` so they drop the live overlay at once
+      (over-limit strokes relay nothing). Always answered
+      `:demo_stroke_acked %{stroke_id, ok}` (`reason` when not ok).
+    * `clear/2`: wipes the board (`:demo_board_cleared` to every tab).
+
+  Over-limit commands and invalid chunks queue no broadcast; an invalid
+  finished stroke queues only its `:demo_stroke_abandon`.
+  """
+
+  import Hologram.Component,
+    only: [put_action: 3, put_broadcast_except: 5, put_subscription: 2]
+
+  alias Hologram.Server
+  alias Scrawly.Games.{DemoBoardServer, StrokeRules}
+  alias ScrawlyWeb.{Auth, RateLimiter}
+
+  # Exclusive upper bound on a completed stroke's path length (chars). The
+  # client splits longer gestures into several strokes below this.
+  @max_path_length 8_000
+
+  # {max events, window ms} per actor. The client sends at most one chunk per
+  # 50 ms, and only once the previous one was acked.
+  @limits %{
+    clear: {1, 5_000},
+    stroke_complete: {20, 1_000},
+    stroke_chunk: {30, 1_000}
+  }
+
+  @doc "The rate limits per actor: `%{bucket => {max, window_ms}}`."
+  def limits, do: @limits
+
+  @doc "Exclusive upper bound on a completed stroke's path length."
+  def max_path_length, do: @max_path_length
+
+  @doc """
+  The transport the home page uses for the demo board: `:channel` (the
+  `demo:board` Phoenix channel) or `:realtime` (these commands). Switchable
+  until the measured gate decides (`config :scrawly, :demo_board_transport`).
+  """
+  @spec transport() :: :channel | :realtime
+  def transport do
+    case Application.get_env(:scrawly, :demo_board_transport, :channel) do
+      :realtime -> :realtime
+      _other -> :channel
+    end
+  end
+
+  @doc """
+  Replies `:demo_board_loaded %{strokes}` with the stored strokes. With
+  `resubscribe: true` (a page restored by Back/Forward, whose subscriptions the
+  connection dropped when it was left) it subscribes the page to the board's
+  channel again, as `HomePage.init/3` does.
+  """
+  @spec load(map, Server.t()) :: Server.t()
+  def load(params, %Server{} = server) do
+    server =
+      if Map.get(params, :resubscribe) == true,
+        do: put_subscription(server, DemoBoardServer.channel()),
+        else: server
+
+    put_action(server, :demo_board_loaded, strokes: DemoBoardServer.get_strokes())
+  end
+
+  @doc "Relays one live chunk to the other tabs and acks it (see the moduledoc)."
+  @spec chunk(map, Server.t()) :: Server.t()
+  def chunk(params, %Server{} = server) do
+    with :ok <- take(server, :stroke_chunk),
+         {:ok, chunk} <- StrokeRules.chunk(params) do
+      server
+      |> put_broadcast_except(
+        {:instance, server.instance_id},
+        DemoBoardServer.channel(),
+        :demo_chunk_in,
+        chunk
+      )
+      |> put_action(:demo_chunk_acked, ok: true)
+    else
+      _rate_limited_or_invalid -> put_action(server, :demo_chunk_acked, ok: false)
+    end
+  end
+
+  @doc "Stores a finished stroke, or rejects it (see the moduledoc)."
+  @spec complete_stroke(map, Server.t()) :: Server.t()
+  def complete_stroke(params, %Server{} = server) do
+    stroke_id = Map.get(params, :stroke_id)
+
+    with :ok <- take(server, :stroke_complete),
+         {:ok, stroke} <- stroke(params) do
+      # Stored with its stroke_id, which `:demo_stroke_added` carries to
+      # every tab, the sender included.
+      DemoBoardServer.add_stroke(stroke)
+      put_action(server, :demo_stroke_acked, stroke_id: stroke_id, ok: true)
+    else
+      :rate_limited -> nack_stroke(server, stroke_id, :rate_limited)
+      :invalid_stroke -> server |> abandon(stroke_id) |> nack_stroke(stroke_id, :invalid_stroke)
+    end
+  end
+
+  @doc "Clears the board, at most once per 5 s per actor."
+  @spec clear(map, Server.t()) :: Server.t()
+  def clear(_params, %Server{} = server) do
+    case take(server, :clear) do
+      :ok -> DemoBoardServer.clear()
+      :rate_limited -> :ok
+    end
+
+    server
+  end
+
+  defp take(server, bucket),
+    do: RateLimiter.take(Auth.actor_key(server), bucket, Map.fetch!(@limits, bucket))
+
+  defp stroke(params) do
+    stroke = %{
+      stroke_id: Map.get(params, :stroke_id),
+      path: Map.get(params, :path),
+      color: Map.get(params, :color),
+      width: Map.get(params, :width)
+    }
+
+    if StrokeRules.valid_stroke_id?(stroke.stroke_id) and StrokeRules.valid_path?(stroke.path) and
+         String.length(stroke.path) < @max_path_length and
+         StrokeRules.valid_color?(stroke.color) and StrokeRules.valid_width?(stroke.width),
+       do: {:ok, stroke},
+       else: :invalid_stroke
+  end
+
+  # Peers drop their live overlay for the id now; only a valid id is relayed.
+  # An over-limit stroke is not relayed (peers' idle sweep removes it), so
+  # abandons stay within the stroke limit.
+  defp abandon(server, stroke_id) do
+    if StrokeRules.valid_stroke_id?(stroke_id) do
+      put_broadcast_except(
+        server,
+        {:instance, server.instance_id},
+        DemoBoardServer.channel(),
+        :demo_stroke_abandon,
+        %{stroke_id: stroke_id}
+      )
+    else
+      server
+    end
+  end
+
+  defp nack_stroke(server, stroke_id, reason) do
+    put_action(server, :demo_stroke_acked,
+      stroke_id: if(is_binary(stroke_id), do: stroke_id),
+      ok: false,
+      reason: reason
+    )
+  end
+end
