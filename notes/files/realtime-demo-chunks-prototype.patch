+++ b/lib/scrawly_web/rate_limiter.ex
@@ -0,0 +1,111 @@
+defmodule ScrawlyWeb.RateLimiter do
+  @moduledoc """
+  Sliding-window rate limits for Hologram commands.
+
+  A Phoenix channel kept its counters in the socket's assigns; a command has
+  no per-connection state, so the windows live here, keyed by
+  `{actor, bucket}` where `actor` is `ScrawlyWeb.Auth.actor_key/1` (the user
+  id, or `"anon:<hash of the session id>"`). `take/3` admits an event when the
+  actor sent fewer than `max` events of that bucket within the last
+  `window_ms` and records it; over-limit events are not recorded. A `nil`
+  actor (no session) is always limited.
+
+  Every call goes through this process, so check-and-record is atomic per
+  key. Timestamps are monotonic ms; idle keys are swept periodically. State
+  is lost on restart (the app runs on a single machine).
+  """
+
+  use GenServer
+
+  @table __MODULE__
+  @sweep_every_ms 30_000
+  # Longest window a bucket may use; older events are swept.
+  @max_window_ms 60_000
+
+  @type limit :: {pos_integer, pos_integer}
+
+  def start_link(opts \\ []), do: GenServer.start_link(__MODULE__, opts, name: __MODULE__)
+
+  @doc """
+  Admits (`:ok`) and records one `bucket` event for `actor`, or answers
+  `:rate_limited` when `limit` (`{max, window_ms}`, window at most
+  #{@max_window_ms} ms) is used up.
+  """
+  @spec take(term, atom, limit, integer) :: :ok | :rate_limited
+  def take(actor, bucket, limit, now \\ System.monotonic_time(:millisecond))
+
+  def take(nil, _bucket, _limit, _now), do: :rate_limited
+
+  def take(actor, bucket, {max, window_ms}, now)
+      when is_integer(max) and max > 0 and is_integer(window_ms) and window_ms > 0 and
+             window_ms <= @max_window_ms do
+    GenServer.call(__MODULE__, {:take, {actor, bucket}, max, window_ms, now})
+  end
+
+  @doc "Forgets every recorded event of `actor` (tests)."
+  @spec reset(term) :: :ok
+  def reset(actor), do: GenServer.call(__MODULE__, {:reset, actor})
+
+  @doc false
+  def sweep(now \\ System.monotonic_time(:millisecond)),
+    do: GenServer.call(__MODULE__, {:sweep, now})
+
+  @impl true
+  def init(_opts) do
+    :ets.new(@table, [:named_table, :set, :protected])
+    schedule_sweep()
+    {:ok, nil}
+  end
+
+  @impl true
+  def handle_call({:take, key, max, window_ms, now}, _from, state) do
+    # Newest first, so the events still inside the window are a prefix.
+    recent =
+      case :ets.lookup(@table, key) do
+        [{^key, events}] -> Enum.take_while(events, &(now - &1 < window_ms))
+        [] -> []
+      end
+
+    if length(recent) < max do
+      :ets.insert(@table, {key, [now | recent]})
+      {:reply, :ok, state}
+    else
+      :ets.insert(@table, {key, recent})
+      {:reply, :rate_limited, state}
+    end
+  end
+
+  def handle_call({:reset, actor}, _from, state) do
+    :ets.match_delete(@table, {{actor, :_}, :_})
+    {:reply, :ok, state}
+  end
+
+  def handle_call({:sweep, now}, _from, state) do
+    {:reply, :ok, do_sweep(now, state)}
+  end
+
+  @impl true
+  def handle_info(:sweep, state) do
+    schedule_sweep()
+    {:noreply, do_sweep(System.monotonic_time(:millisecond), state)}
+  end
+
+  defp do_sweep(now, state) do
+    :ets.foldl(
+      fn {key, events}, :ok ->
+        case events do
+          [newest | _] when now - newest < @max_window_ms -> :ok
+          _stale -> :ets.delete(@table, key)
+        end
+
+        :ok
+      end,
+      :ok,
+      @table
+    )
+
+    state
+  end
+
+  defp schedule_sweep, do: Process.send_after(self(), :sweep, @sweep_every_ms)
+end
diff --git a/lib/scrawly_web/pages/remote_strokes.mjs b/lib/scrawly_web/pages/remote_strokes.mjs
new file mode 100644
index 0000000..1a0f091
--- /dev/null
+++ b/lib/scrawly_web/pages/remote_strokes.mjs
@@ -0,0 +1,102 @@
+// Bookkeeping for peers' strokes in progress (the live overlays fed by
+// unsequenced stroke chunks), shared by the demo board and the game canvas.
+// Pure: no DOM and no timers; callers draw `entry.path` and run the idle
+// sweep from their own timer. Tests: test/js/remote_strokes.test.mjs.
+//
+// Chunks carry a per-stroke `seq` and arrive unordered and at most once:
+//   * a chunk whose seq is <= the last applied one for its stroke is dropped;
+//   * the first chunk seen for a stroke starts the path at its first point
+//     (startDelta), so joining mid-stroke works;
+//   * a closed stroke (completed, abandoned, cleared or swept) never comes
+//     back: its id is remembered (bounded, oldest forgotten first), so a
+//     late chunk cannot recreate an orphan overlay;
+//   * a stroke that got no chunk for `idleMs` is idle: its drawer left
+//     mid-stroke (closed the tab, lost the network) and no completion will
+//     come. There is no disconnect hook, so the owner sweeps idle() ids.
+
+import { startDelta } from "./stroke_engine.mjs";
+
+export const OVERLAY_IDLE_MS = 5000;
+export const MAX_CLOSED_IDS = 1000;
+
+export function createRemoteStrokes(opts) {
+  const idleMs = (opts && opts.idleMs) || OVERLAY_IDLE_MS;
+  const maxClosed = (opts && opts.maxClosed) || MAX_CLOSED_IDS;
+  const live = new Map();
+  const closed = new Set();
+
+  function remember(id) {
+    closed.delete(id);
+    closed.add(id);
+    if (closed.size > maxClosed) closed.delete(closed.values().next().value);
+  }
+
+  return {
+    // Applies one chunk. Returns the stroke's entry ({id, path, color, width,
+    // lastSeq, lastAt, el}) with its path extended, or null when the chunk is
+    // dropped (closed id, stale seq, or a first delta with no readable point).
+    // `el` is the caller's (its overlay element).
+    append(id, seq, delta, color, width, now) {
+      if (!id || typeof delta !== "string" || delta === "" || closed.has(id)) return null;
+
+      let entry = live.get(id);
+      if (entry && typeof seq === "number" && seq <= entry.lastSeq) return null;
+
+      if (!entry || entry.path === "") {
+        delta = startDelta(delta);
+        if (!delta) return null;
+      }
+
+      if (!entry) {
+        entry = { id: id, path: "", color: "#000000", width: 2, lastSeq: 0, lastAt: now, el: null };
+        live.set(id, entry);
+      }
+
+      entry.path += delta;
+      if (typeof seq === "number") entry.lastSeq = seq;
+      entry.lastAt = now;
+      if (color) entry.color = color;
+      if (width) entry.width = width;
+      return entry;
+    },
+
+    // Ends a stroke for good (completed, abandoned, cleared, swept). Returns
+    // its entry, or null when none was live.
+    close(id) {
+      if (!id) return null;
+      const entry = live.get(id) || null;
+      live.delete(id);
+      remember(id);
+      return entry;
+    },
+
+    // Forgets a live stroke without closing it (a snapshot replaced the
+    // canvas: later chunks of a stroke still being drawn start it afresh).
+    drop(id) {
+      const entry = live.get(id) || null;
+      live.delete(id);
+      return entry;
+    },
+
+    get(id) {
+      return live.get(id) || null;
+    },
+
+    isClosed(id) {
+      return closed.has(id);
+    },
+
+    entries() {
+      return Array.from(live.values());
+    },
+
+    // Ids of live strokes with no chunk for idleMs or longer.
+    idle(now) {
+      const ids = [];
+      live.forEach(function (entry) {
+        if (now - entry.lastAt >= idleMs) ids.push(entry.id);
+      });
+      return ids;
+    },
+  };
+}
diff --git a/test/js/remote_strokes.test.mjs b/test/js/remote_strokes.test.mjs
new file mode 100644
index 0000000..f199713
--- /dev/null
+++ b/test/js/remote_strokes.test.mjs
@@ -0,0 +1,90 @@
+// Peers' strokes in progress (lib/scrawly_web/pages/remote_strokes.mjs): the
+// unsequenced live chunk stream of the demo board and the game canvas.
+// Run with `node --test test/js/*.test.mjs` (test/scrawly_web/js_unit_test.exs).
+
+import { test } from "node:test";
+import assert from "node:assert/strict";
+
+import {
+  createRemoteStrokes,
+  OVERLAY_IDLE_MS,
+  MAX_CLOSED_IDS,
+} from "../../lib/scrawly_web/pages/remote_strokes.mjs";
+
+test("chunks extend a stroke's path in seq order; the first one starts it", () => {
+  const r = createRemoteStrokes();
+  const a = r.append("s1", 1, "M 1 2", "#ff0000", 4, 0);
+  assert.equal(a.path, "M 1 2");
+  assert.equal(a.color, "#ff0000");
+  assert.equal(a.width, 4);
+  const b = r.append("s1", 2, " Q 1 2 3 4", "#ff0000", 4, 10);
+  assert.equal(b, a);
+  assert.equal(a.path, "M 1 2 Q 1 2 3 4");
+  assert.equal(a.lastSeq, 2);
+  assert.equal(a.lastAt, 10);
+});
+
+test("a stale or repeated seq is dropped", () => {
+  const r = createRemoteStrokes();
+  r.append("s1", 1, "M 1 2", "#000000", 2, 0);
+  r.append("s1", 3, " L 5 6", "#000000", 2, 1);
+  assert.equal(r.append("s1", 2, " L 3 4", "#000000", 2, 2), null);
+  assert.equal(r.append("s1", 3, " L 5 6", "#000000", 2, 3), null);
+  assert.equal(r.get("s1").path, "M 1 2 L 5 6");
+  assert.equal(r.get("s1").lastSeq, 3);
+  assert.equal(r.get("s1").lastAt, 1);
+});
+
+test("joining mid-stroke starts the path at the chunk's first point", () => {
+  const r = createRemoteStrokes();
+  assert.equal(r.append("s1", 5, " L 7 8 L 9 9", "#000000", 2, 0).path, "M 7 8 L 9 9");
+  assert.equal(r.append("s2", 5, " Q 1 1 2 2 Q 3 3 4 4", "#000000", 2, 0).path, "M 2 2 Q 3 3 4 4");
+  // No readable point: nothing is created.
+  assert.equal(r.append("s3", 1, " Z", "#000000", 2, 0), null);
+  assert.equal(r.get("s3"), null);
+  assert.equal(r.append("s4", 1, "", "#000000", 2, 0), null);
+  assert.equal(r.append(null, 1, "M 1 1", "#000000", 2, 0), null);
+});
+
+test("a closed stroke never comes back", () => {
+  const r = createRemoteStrokes();
+  r.append("s1", 1, "M 1 2", "#000000", 2, 0);
+  const closed = r.close("s1");
+  assert.equal(closed.path, "M 1 2");
+  assert.ok(r.isClosed("s1"));
+  assert.equal(r.append("s1", 2, " L 3 4", "#000000", 2, 1), null);
+  // Closing an id never seen also blocks its late chunks.
+  assert.equal(r.close("s9"), null);
+  assert.equal(r.append("s9", 1, "M 1 1", "#000000", 2, 1), null);
+});
+
+test("closed ids are bounded, oldest forgotten first", () => {
+  const r = createRemoteStrokes({ maxClosed: 3 });
+  ["a", "b", "c", "d"].forEach((id) => r.close(id));
+  assert.equal(r.isClosed("a"), false);
+  assert.ok(r.isClosed("b") && r.isClosed("c") && r.isClosed("d"));
+  assert.equal(MAX_CLOSED_IDS, 1000);
+});
+
+test("drop forgets a stroke without closing it (snapshot)", () => {
+  const r = createRemoteStrokes();
+  r.append("s1", 4, "M 1 2", "#000000", 2, 0);
+  r.drop("s1");
+  assert.equal(r.get("s1"), null);
+  assert.equal(r.isClosed("s1"), false);
+  assert.equal(r.append("s1", 5, " L 3 4", "#000000", 2, 1).path, "M 3 4");
+});
+
+test("idle sweep: strokes with no chunk for idleMs", () => {
+  assert.equal(OVERLAY_IDLE_MS, 5000);
+  const r = createRemoteStrokes();
+  r.append("old", 1, "M 1 1", "#000000", 2, 0);
+  r.append("busy", 1, "M 1 1", "#000000", 2, 0);
+  r.append("busy", 2, " L 2 2", "#000000", 2, 4000);
+  assert.deepEqual(r.idle(4999), []);
+  assert.deepEqual(r.idle(5000), ["old"]);
+  assert.deepEqual(r.idle(9000).sort(), ["busy", "old"]);
+  r.close("old");
+  assert.deepEqual(r.idle(9000), ["busy"]);
+  assert.deepEqual(r.entries().map((e) => e.id), ["busy"]);
+});
